-<Directory "/usr/share/ipa/modern-ui">
+Alias /ipa/modern-ui "$USR_SHARE_IPA_DIR/modern-ui"
+<Directory "$USR_SHARE_IPA_DIR/modern-ui">
   SetHandler None
   AllowOverride None
   Satisfy Any
@@ -222,8 +231,8 @@
 </Directory>
 
 #  Simple wsgi scripts required by ui
-Alias /ipa/wsgi "/usr/share/ipa/wsgi"
-<Directory "/usr/share/ipa/wsgi">
